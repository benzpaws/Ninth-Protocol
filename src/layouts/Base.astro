---
import '../styles/global.css';
import { SITE } from '../content/site';
import Preloader from '../components/chrome/Preloader.astro';
import TopBar from '../components/chrome/TopBar.astro';
import MobileDrawer from '../components/chrome/MobileDrawer.astro';
import Footer from '../components/chrome/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.og.title,
  description = 'For those who answer to no one. Ninth Protocol is a private procurement firm for UHNW individuals and family offices. Conflict-free, fiduciary, discreet.',
} = Astro.props;

const ogImage = new URL(SITE.og.image, Astro.site ?? 'https://ninthprotocol.eu/').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0E0B22" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={SITE.og.title} />
    <meta property="og:description" content={SITE.og.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString() ?? 'https://ninthprotocol.eu/'} />

    <link rel="icon" type="image/svg+xml" href="/assets/np-mark.svg" />
    <link rel="alternate icon" type="image/png" href="/assets/np-mark.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="application-name" content="Ninth Protocol" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ninth Protocol" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-TileColor" content="#0E0B22" />
    <meta name="msapplication-TileImage" content="/assets/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=JetBrains+Mono:wght@300;400&family=Inter:wght@300;400;500;600&display=swap"
    />
  </head>

  <body class="is-loading">
    <a href="#top" class="skip-link">Skip to content</a>

    <Preloader />

    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    <TopBar />
    <MobileDrawer />

    <main id="top">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Drives the hero is-loaded cascade. Moves into Preloader.astro when
      // chrome is ported; for now it lives here so the page is scrollable
      // (body.is-loading locks overflow) and the hero opens correctly.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function flip() {
          document.body.classList.remove('is-loading');
          document.body.classList.add('is-loaded');
        }
        if (reduced) {
          flip();
        } else if (document.readyState === 'complete') {
          setTimeout(flip, 1900);
        } else {
          window.addEventListener('load', function () {
            setTimeout(flip, 1900);
          });
        }
        setTimeout(flip, 4000);
      })();

      // Bidirectional reveal engine. Each [data-anim] element gets one of
      // three states depending on its viewport position so reveals look
      // right scrolling both down and up. Mirrors archive/v1/script.js.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var animEls = Array.prototype.slice.call(document.querySelectorAll('[data-anim]'));

        if (reduced || !('IntersectionObserver' in window)) {
          animEls.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }

        animEls.forEach(function (el) { el.classList.add('is-out-down'); });

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var el = entry.target;
            var rect = entry.boundingClientRect;
            if (entry.isIntersecting) {
              el.classList.remove('is-out-up', 'is-out-down');
              el.classList.add('is-in');
            } else {
              el.classList.remove('is-in');
              if (rect.top < 0) {
                el.classList.add('is-out-up');
                el.classList.remove('is-out-down');
              } else {
                el.classList.add('is-out-down');
                el.classList.remove('is-out-up');
              }
            }
          });
        }, { threshold: [0, 0.05, 0.1], rootMargin: '-5% 0px -5% 0px' });

        animEls.forEach(function (el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 200;
    pointer-events: none;
  }
</style>
