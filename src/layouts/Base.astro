---
import '../styles/global.css';
import { SITE } from '../content/site';
import Preloader from '../components/chrome/Preloader.astro';
import TopBar from '../components/chrome/TopBar.astro';
import MobileDrawer from '../components/chrome/MobileDrawer.astro';
import Footer from '../components/chrome/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.og.title,
  description = 'For those who answer to no one. Ninth Protocol is a private procurement firm for UHNW individuals and family offices. Conflict-free, fiduciary, discreet.',
} = Astro.props;

const ogImage = new URL(SITE.og.image, Astro.site ?? 'https://ninthprotocol.eu/').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0E0B22" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={SITE.og.title} />
    <meta property="og:description" content={SITE.og.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString() ?? 'https://ninthprotocol.eu/'} />

    <link rel="icon" type="image/svg+xml" href="/assets/np-mark.svg" />
    <link rel="alternate icon" type="image/png" href="/assets/np-mark.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="application-name" content="Ninth Protocol" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ninth Protocol" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-TileColor" content="#0E0B22" />
    <meta name="msapplication-TileImage" content="/assets/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=JetBrains+Mono:wght@300;400&family=Inter:wght@300;400;500;600&display=swap"
    />
  </head>

  <body class="is-loading">
    <a href="#top" class="skip-link">Skip to content</a>

    <Preloader />

    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    <TopBar />
    <MobileDrawer />

    <main id="top">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Preloader dismiss + hero is-loaded cascade. Marks the preloader done
      // (fading it out) and flips body.is-loading → body.is-loaded so the
      // hero opens and overflow unlocks. Mirrors archive/v1/script.js.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function dismiss() {
          var preloader = document.getElementById('preloader');
          if (preloader) preloader.classList.add('is-done');
          document.body.classList.remove('is-loading');
          document.body.classList.add('is-loaded');
        }
        if (reduced) {
          dismiss();
        } else if (document.readyState === 'complete') {
          setTimeout(dismiss, 1900);
        } else {
          window.addEventListener('load', function () {
            setTimeout(dismiss, 1900);
          });
        }
        setTimeout(dismiss, 4000);
      })();

      // Smooth anchor scroll. Offsets target by topbar height; closes mobile
      // drawer if open so the destination is actually visible.
      (function () {
        document.querySelectorAll('a[href^="#"]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            var id = this.getAttribute('href');
            if (!id || id === '#') return;

            var drawer = document.getElementById('drawer');
            if (drawer && drawer.classList.contains('is-open')) {
              drawer.classList.remove('is-open');
              var toggle = document.getElementById('menuToggle');
              if (toggle) {
                toggle.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
              }
              document.body.classList.remove('menu-open');
            }

            if (id === '#top') {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: 'smooth' });
              return;
            }

            var target = document.querySelector(id);
            if (target) {
              e.preventDefault();
              var y = target.getBoundingClientRect().top + window.pageYOffset - 70;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          });
        });
      })();

      // rAF-throttled scroll handler: scroll-progress bar + topbar hide on
      // scroll-down / show on scroll-up + parallax for background marks.
      (function () {
        var progress = document.getElementById('scrollProgress');
        var topbar = document.getElementById('topbar');
        var parallaxEls = Array.prototype.slice.call(
          document.querySelectorAll('.hero__bg-mark, .contact__bg-mark')
        ).map(function (el) { return { el: el, factor: 0.15 }; });

        var lastY = window.scrollY;
        var ticking = false;

        function update() {
          var y = window.scrollY;

          if (progress) {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            progress.style.transform = 'scaleX(' + (y / Math.max(max, 1)) + ')';
          }

          if (topbar) {
            if (y > 200 && y > lastY + 8) {
              topbar.classList.add('is-hidden');
            } else if (y < lastY - 8 || y < 100) {
              topbar.classList.remove('is-hidden');
            }
          }

          parallaxEls.forEach(function (item) {
            var parent = item.el.parentElement;
            if (!parent) return;
            var rect = parent.getBoundingClientRect();
            var center = rect.top + rect.height / 2;
            var offset = (center - window.innerHeight / 2) * item.factor * -1;
            item.el.style.setProperty('--parallax-y', offset.toFixed(1));
          });

          lastY = y;
          ticking = false;
        }

        window.addEventListener('scroll', function () {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
      })();

      // Bidirectional reveal engine. Each [data-anim] element gets one of
      // three states depending on its viewport position so reveals look
      // right scrolling both down and up. Mirrors archive/v1/script.js.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var animEls = Array.prototype.slice.call(document.querySelectorAll('[data-anim]'));

        if (reduced || !('IntersectionObserver' in window)) {
          animEls.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }

        animEls.forEach(function (el) { el.classList.add('is-out-down'); });

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var el = entry.target;
            var rect = entry.boundingClientRect;
            if (entry.isIntersecting) {
              el.classList.remove('is-out-up', 'is-out-down');
              el.classList.add('is-in');
            } else {
              el.classList.remove('is-in');
              if (rect.top < 0) {
                el.classList.add('is-out-up');
                el.classList.remove('is-out-down');
              } else {
                el.classList.add('is-out-down');
                el.classList.remove('is-out-up');
              }
            }
          });
        }, { threshold: [0, 0.05, 0.1], rootMargin: '-5% 0px -5% 0px' });

        animEls.forEach(function (el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 200;
    pointer-events: none;
  }
</style>
