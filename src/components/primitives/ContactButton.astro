---
import { mailtoUrl, whatsappUrl } from '../../content/site';

interface Props {
  channel: 'email' | 'whatsapp';
  variant?: 'outline' | 'fill';
  size?: 'md' | 'lg';
  label?: string;
}

const { channel, variant = 'outline', size = 'md', label } = Astro.props;

const href = channel === 'email' ? mailtoUrl : whatsappUrl;
const buttonLabel = label ?? (channel === 'email' ? 'Email' : 'WhatsApp');
const external = channel === 'whatsapp';

const classes = ['btn', variant === 'fill' ? 'btn--gold-fill' : 'btn--gold', size === 'lg' && 'btn--lg']
  .filter(Boolean)
  .join(' ');
---

<a
  href={href}
  class={classes}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  {
    channel === 'email' ? (
      <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 7l9 6 9-6M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M3 7a2 2 0 012-2h14a2 2 0 012 2" />
      </svg>
    ) : (
      <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
    )
  }
  <span class="btn__text">{buttonLabel}</span>
  <span class="btn__arrow">→</span>
</a>

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 28px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border: 1px solid;
    position: relative;
    overflow: hidden;
    transition: all 0.5s var(--ease-out);
    cursor: pointer;
    background: transparent;
  }

  .btn__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    z-index: 2;
    transition: transform 0.4s var(--ease-out);
  }

  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    transform: translateY(101%);
    transition: transform 0.6s var(--ease-out);
    z-index: 0;
  }

  .btn > * {
    position: relative;
    z-index: 1;
  }
  .btn:hover::before {
    transform: translateY(0);
  }
  .btn:hover {
    color: var(--color-indigo);
    border-color: var(--color-gold);
  }
  .btn:hover .btn__icon {
    transform: scale(1.1);
  }

  .btn--gold {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  .btn--gold-fill {
    color: var(--color-indigo);
    background: var(--color-gold);
    border-color: var(--color-gold);
  }
  .btn--gold-fill::before {
    background: var(--color-gold-soft);
  }
  .btn--gold-fill:hover {
    color: var(--color-indigo);
  }

  .btn--lg {
    padding: 22px 38px;
    font-size: 14px;
  }

  .btn__arrow {
    transition: transform 0.4s var(--ease-out);
  }
  .btn:hover .btn__arrow {
    transform: translateX(6px);
  }
</style>
