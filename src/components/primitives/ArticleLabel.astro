---
interface Props {
  roman: string;
  name: string;
  tone?: 'dark' | 'light';
}

const { roman, name, tone } = Astro.props;

const markClass = tone === 'light' ? 'art-mark art-mark--light' : 'art-mark';
const ruleClass = tone === 'light' ? 'art-rule art-rule--light' : 'art-rule';
const nameClass =
  tone === 'dark' ? 'art-name art-name--dark' : tone === 'light' ? 'art-name art-name--light' : 'art-name';
---

<span class={markClass}>{roman}</span>
<span class={ruleClass} aria-hidden="true"></span>
<span class={nameClass}>{name}</span>

<style is:global>
  .art-mark {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 28px;
    color: var(--color-gold);
    min-width: 44px;
  }
  .art-mark--light {
    color: var(--color-gold);
  }

  .art-rule {
    display: inline-block;
    width: 80px;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.5;
    margin: 0 16px;
    vertical-align: middle;
  }
  .art-rule--light {
    opacity: 0.7;
  }

  .art-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.7);
  }
  .art-name--dark {
    color: var(--color-ink);
    opacity: 0.75;
  }
  .art-name--light {
    color: var(--color-off-white);
    opacity: 0.85;
  }

  @media (max-width: 720px) {
    .art-mark {
      font-size: 22px;
      min-width: auto;
    }
    .art-rule {
      width: 40px;
      margin: 0 10px;
    }
    .art-name {
      font-size: 10px;
      letter-spacing: 0.25em;
    }
  }
</style>
