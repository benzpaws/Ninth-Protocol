---
import { SITE } from '../../content/site';
import NPMark from '../primitives/NPMark.astro';
---

<footer class="footer">
  <div class="footer__bar"></div>
  <nav class="footer__nav" aria-label="Secondary">
    <a href="/mandate-process" class="footer__nav-link">The mandate process</a>
  </nav>
  <div class="footer__inner">
    <div class="footer__brand">
      <span class="footer__mark">
        <NPMark alt="" />
      </span>
      <div class="footer__brand-text">
        <p class="footer__name">{SITE.name.toUpperCase()}</p>
        <p class="footer__tag">{SITE.tagline}</p>
      </div>
    </div>

    <div class="footer__meta">
      <p>Ninth Protocol OÜ · Estonia</p>
      <p class="footer__small">© 2025–<span id="year">2026</span> · Classification: Private</p>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var el = document.getElementById('year');
    if (el) el.textContent = String(new Date().getFullYear());
  })();
</script>

<style is:global>
  .footer {
    background: var(--color-indigo-ink);
    color: rgba(245, 242, 236, 0.7);
  }

  .footer__bar {
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--color-gold) 50%, transparent 100%);
    opacity: 0.4;
  }

  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 40px 36px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex; align-items: center; gap: 14px;
  }

  .footer__mark {
    width: 40px; height: 34px;
    display: inline-flex;
  }
  .footer__mark img { max-width: 100%; max-height: 100%; height: 100%; object-fit: contain; }

  .footer__name {
    font-family: var(--font-serif);
    font-size: 12px;
    letter-spacing: 0.35em;
    color: var(--color-gold);
  }

  .footer__tag {
    font-family: var(--font-serif); font-style: italic;
    font-size: 12px;
    color: rgba(245, 242, 236, 0.5);
    margin-top: 2px;
  }

  .footer__meta {
    font-family: var(--font-serif);
    font-size: 13px;
    text-align: right;
    color: rgba(245, 242, 236, 0.55);
  }

  .footer__small {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    margin-top: 6px;
    color: rgba(245, 242, 236, 0.35);
  }

  .footer__nav {
    max-width: var(--container);
    margin: 0 auto;
    padding: 24px 36px 0;
    text-align: center;
  }
  .footer__nav-link {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: rgba(245, 242, 236, 0.45);
    letter-spacing: 0.05em;
    transition: color var(--dur-quick) ease;
  }
  .footer__nav-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 720px) {
    .footer__inner {
      flex-direction: column;
      text-align: center;
      gap: 18px;
      padding: 32px 20px;
    }
    .footer__meta { text-align: center; }
    .footer__nav { padding: 20px 20px 0; }
  }
</style>
