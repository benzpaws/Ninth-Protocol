---
import { SITE, mailtoUrl, whatsappUrl } from '../../content/site';
import NPMark from '../primitives/NPMark.astro';

const articles = SITE.articles;
---

<nav class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer__inner">
    <div class="drawer__head">
      <span class="drawer__mark">
        <NPMark alt="" />
      </span>
      <span class="drawer__name">{SITE.name.toUpperCase()}</span>
    </div>

    <ul class="drawer__nav">
      <li><a href="#top"><span>{articles.hero.roman}</span><em>{articles.hero.name}</em></a></li>
      <li><a href="#model"><span>{articles.model.roman}</span><em>{articles.model.name}</em></a></li>
      <li><a href="#capabilities"><span>{articles.capabilities.roman}</span><em>{articles.capabilities.name}</em></a></li>
      <li><a href="#contact"><span>{articles.contact.roman}</span><em>{articles.contact.name}</em></a></li>
    </ul>

    <div class="drawer__contact">
      <p class="drawer__line">Reach us directly.</p>
      <a href={mailtoUrl} class="drawer__btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7l9 6 9-6M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M3 7a2 2 0 012-2h14a2 2 0 012 2"/></svg>
        <span>{SITE.email}</span>
      </a>
      <a href={whatsappUrl} class="drawer__btn drawer__btn--whatsapp" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span>WhatsApp {SITE.whatsapp.display}</span>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  // Drawer toggle wires the hamburger button (#menuToggle in TopBar) to the
  // drawer's .is-open state and locks body scroll while open.
  (function () {
    var toggle = document.getElementById('menuToggle');
    var drawer = document.getElementById('drawer');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function () {
      var isOpen = drawer.classList.toggle('is-open');
      toggle.classList.toggle('is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      document.body.classList.toggle('menu-open', isOpen);
    });
  })();
</script>

<style is:global>
  .drawer {
    position: fixed; inset: 0;
    background: var(--color-indigo-night);
    z-index: 90;
    opacity: 0; visibility: hidden;
    transition: opacity 0.5s var(--ease-out), visibility 0s 0.5s;
  }
  .drawer.is-open {
    opacity: 1; visibility: visible;
    transition: opacity 0.5s var(--ease-out), visibility 0s;
  }

  .drawer__inner {
    padding: calc(100px + env(safe-area-inset-top, 0)) 32px calc(40px + env(safe-area-inset-bottom, 0));
    padding-left: calc(32px + env(safe-area-inset-left, 0));
    padding-right: calc(32px + env(safe-area-inset-right, 0));
    height: 100%;
    display: flex; flex-direction: column;
  }

  .drawer__head {
    display: flex; flex-direction: column; align-items: center;
    gap: 16px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--gold-line);
    margin-bottom: 32px;
  }
  .drawer__mark { width: 56px; height: 48px; display: inline-flex; }
  .drawer__mark img { max-width: 100%; max-height: 100%; height: 100%; object-fit: contain; }
  .drawer__name {
    font-family: var(--font-serif);
    font-size: 14px; letter-spacing: 0.4em;
    color: var(--color-gold);
    padding-left: 0.4em;
  }

  .drawer__nav { flex: 1; }
  .drawer__nav li {
    border-bottom: 1px solid rgba(245, 242, 236, 0.06);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .drawer.is-open .drawer__nav li {
    opacity: 1; transform: translateY(0);
  }
  .drawer.is-open .drawer__nav li:nth-child(1) { transition-delay: 0.15s; }
  .drawer.is-open .drawer__nav li:nth-child(2) { transition-delay: 0.22s; }
  .drawer.is-open .drawer__nav li:nth-child(3) { transition-delay: 0.29s; }
  .drawer.is-open .drawer__nav li:nth-child(4) { transition-delay: 0.36s; }

  .drawer__nav a {
    display: flex; align-items: baseline; gap: 18px;
    padding: 20px 0;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--color-off-white);
    transition: color var(--dur-quick) ease, padding-left 0.4s var(--ease-out);
  }
  .drawer__nav a:hover { color: var(--color-gold); padding-left: 8px; }
  .drawer__nav a span {
    font-family: var(--font-mono); font-size: 12px;
    color: var(--color-gold); min-width: 36px;
    letter-spacing: 0.05em;
  }
  .drawer__nav a em { font-style: normal; }

  .drawer__contact {
    padding-top: 28px;
    border-top: 1px solid var(--gold-line);
    margin-top: 32px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .drawer__line {
    font-family: var(--font-serif); font-style: italic;
    font-size: 15px;
    color: rgba(245, 242, 236, 0.65);
    margin-bottom: 4px;
    text-align: center;
  }

  .drawer__btn {
    display: flex !important; align-items: center; gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--gold-line);
    background: rgba(192, 161, 30, 0.04);
    color: var(--color-off-white) !important;
    font-family: var(--font-serif);
    font-size: 15px;
    transition: all 0.3s ease;
  }
  .drawer__btn:hover { background: rgba(192, 161, 30, 0.08); border-color: var(--color-gold); }
  .drawer__btn svg {
    width: 18px; height: 18px;
    color: var(--color-gold);
    flex-shrink: 0;
  }
</style>
