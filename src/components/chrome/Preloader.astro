---
import { SITE } from '../../content/site';
import NPMark from '../primitives/NPMark.astro';
---

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader__inner">
    <div class="preloader__mark">
      <NPMark alt="" />
    </div>
    <div class="preloader__name">{SITE.name.toUpperCase()}</div>
    <div class="preloader__tagline">PRIVATE PROCUREMENT</div>
    <div class="preloader__bar"><div class="preloader__bar-fill"></div></div>
  </div>
</div>

<style is:global>
  .preloader {
    position: fixed; inset: 0;
    background: var(--color-indigo-night);
    z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.9s var(--ease-out), visibility 0s 0.9s;
  }
  .preloader.is-done { opacity: 0; visibility: hidden; }

  .preloader__inner {
    text-align: center;
    width: 320px;
    padding: 0 32px;
  }

  .preloader__mark {
    width: 96px; height: 76px;
    margin: 0 auto 32px;
    opacity: 0;
    transform: translateY(8px);
    animation: prFade 1s var(--ease-out) 0.1s forwards;
    display: flex; align-items: center; justify-content: center;
  }
  .preloader__mark img { max-width: 100%; max-height: 100%; height: 100%; object-fit: contain; }

  @keyframes prFade { to { opacity: 1; transform: translateY(0); } }

  .preloader__name {
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.5em;
    color: var(--color-gold);
    margin-bottom: 28px;
    opacity: 0;
    animation: prFade 0.8s var(--ease-out) 0.55s forwards;
    padding-left: 0.5em;
  }

  .preloader__tagline {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.3em;
    color: rgba(192, 161, 30, 0.7);
    margin-top: -20px;
    margin-bottom: 28px;
    padding-left: 0.3em;
    opacity: 0;
    animation: prFade 0.8s var(--ease-out) 1.65s forwards;
  }

  .preloader__bar {
    width: 140px;
    height: 1px;
    background: rgba(245, 242, 236, 0.1);
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }
  .preloader__bar-fill {
    position: absolute; inset: 0;
    background: var(--color-gold);
    transform: scaleX(0); transform-origin: left center;
    animation: prBar 1.6s var(--ease-out) 0.5s forwards;
  }
  @keyframes prBar { to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .preloader { display: none; }
  }
</style>
