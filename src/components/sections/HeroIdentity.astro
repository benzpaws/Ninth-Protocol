---
import { SITE } from '../../content/site';
import ArticleLabel from '../primitives/ArticleLabel.astro';
import NPMark from '../primitives/NPMark.astro';
import ContactButton from '../primitives/ContactButton.astro';

const wordmarkWords = SITE.name.toUpperCase().split(' ');
const article = SITE.articles.hero;
---

<section class="section section--hero" id="hero">
  <div class="hero__bg-mark" aria-hidden="true">
    <NPMark alt="" />
  </div>

  <div class="hero__top">
    <div class="hero__article">
      <ArticleLabel roman={article.roman} name={article.name} />
    </div>
    <div class="hero__stamp">{SITE.hero.stamp}</div>
  </div>

  <div class="hero__inner">
    <div class="hero__mark-wrap">
      <NPMark alt={`${SITE.name} monogram`} class="hero__mark" />
    </div>

    <div class="hero__wordmark">
      {
        wordmarkWords.flatMap((word, wi) => {
          const letters = [...word].map((c) => <span>{c}</span>);
          return wi === 0 ? letters : [<span class="gap" />, ...letters];
        })
      }
    </div>

    <div class="hero__rule"></div>

    <h1 class="hero__motto">
      <span class="reveal-line"><span class="reveal-line__inner">{SITE.motto.leadPlain}</span></span>
      <span class="reveal-line"><span class="reveal-line__inner reveal-line__inner--italic">{SITE.motto.leadItalic}</span></span>
    </h1>

    <p class="hero__sub">{SITE.sub}</p>

    <div class="hero__cta-row">
      <ContactButton channel="email" variant="outline" />
      <ContactButton channel="whatsapp" variant="fill" />
    </div>
  </div>

  <div class="hero__footer">
    <span class="hero__footer-note">{SITE.hero.footerNote}</span>
    <div class="hero__scroll" aria-hidden="true">
      <span>{SITE.hero.scrollCue}</span>
      <div class="hero__scroll-line"></div>
    </div>
  </div>
</section>

<style is:global>
  .section--hero {
    background: var(--color-indigo-night);
    color: var(--color-off-white);
  }

  .section--hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 30%, rgba(192, 161, 30, 0.05) 0%, transparent 70%),
      radial-gradient(ellipse at bottom, rgba(58, 51, 112, 0.5) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero__bg-mark {
    --parallax-y: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(900px, 80vw);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transform: translate(-50%, calc(-50% + var(--parallax-y) * 1px));
    transition: opacity 1.6s var(--ease-out) 0.4s;
  }
  .hero__bg-mark img {
    width: 100%;
    height: auto;
    opacity: 0.04;
    filter: blur(0.5px);
  }
  .is-loaded .hero__bg-mark {
    opacity: 1;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 2;
    padding-top: 12px;
  }

  .hero__article {
    display: flex;
    align-items: center;
  }

  .hero__stamp {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: rgba(245, 242, 236, 0.45);
  }

  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 40px 0;
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero__mark-wrap {
    width: 110px;
    height: 92px;
    margin-bottom: 28px;
    opacity: 0;
    transform: scale(0.85) translateY(20px);
    transition:
      opacity 1.2s var(--ease-out) 0.3s,
      transform 1.2s var(--ease-elastic) 0.3s;
  }
  .hero__mark {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .is-loaded .hero__mark-wrap {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .hero__wordmark {
    font-family: var(--font-serif);
    font-size: clamp(13px, 1.5vw, 16px);
    letter-spacing: 0.6em;
    color: var(--color-gold);
    margin-bottom: 32px;
    font-weight: 400;
    display: inline-flex;
    padding-left: 0.6em;
  }
  .hero__wordmark .gap {
    width: 0.6em;
  }
  .hero__wordmark span {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
  }
  .is-loaded .hero__wordmark span {
    animation: wordmarkIn 0.7s var(--ease-out) forwards;
  }
  .is-loaded .hero__wordmark span:nth-child(1)  { animation-delay: 0.55s; }
  .is-loaded .hero__wordmark span:nth-child(2)  { animation-delay: 0.60s; }
  .is-loaded .hero__wordmark span:nth-child(3)  { animation-delay: 0.65s; }
  .is-loaded .hero__wordmark span:nth-child(4)  { animation-delay: 0.70s; }
  .is-loaded .hero__wordmark span:nth-child(5)  { animation-delay: 0.75s; }
  .is-loaded .hero__wordmark span:nth-child(7)  { animation-delay: 0.85s; }
  .is-loaded .hero__wordmark span:nth-child(8)  { animation-delay: 0.90s; }
  .is-loaded .hero__wordmark span:nth-child(9)  { animation-delay: 0.95s; }
  .is-loaded .hero__wordmark span:nth-child(10) { animation-delay: 1.00s; }
  .is-loaded .hero__wordmark span:nth-child(11) { animation-delay: 1.05s; }
  .is-loaded .hero__wordmark span:nth-child(12) { animation-delay: 1.10s; }
  .is-loaded .hero__wordmark span:nth-child(13) { animation-delay: 1.15s; }
  .is-loaded .hero__wordmark span:nth-child(14) { animation-delay: 1.20s; }

  @keyframes wordmarkIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__rule {
    width: 0;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.7;
    margin-bottom: 40px;
    transition: width 1.4s var(--ease-out) 1.3s;
  }
  .is-loaded .hero__rule {
    width: 100px;
  }

  .hero__motto {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(50px, 9vw, 132px);
    line-height: 1;
    color: #FFFFFF;
    letter-spacing: -0.025em;
    margin-bottom: 48px;
  }

  .is-loaded .hero__motto .reveal-line:nth-child(1) .reveal-line__inner {
    transition-delay: 1.4s;
  }
  .is-loaded .hero__motto .reveal-line:nth-child(2) .reveal-line__inner {
    transition-delay: 1.55s;
  }
  .is-loaded .hero__motto .reveal-line__inner {
    transform: translateY(0);
    opacity: 1;
  }

  .hero__sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(18px, 2.4vw, 26px);
    line-height: 1.4;
    color: rgba(245, 242, 236, 0.78);
    margin-bottom: 56px;
    max-width: 720px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 1s var(--ease-out) 1.85s,
      transform 1s var(--ease-out) 1.85s;
  }
  .is-loaded .hero__sub {
    opacity: 1;
    transform: translateY(0);
  }

  .hero__cta-row {
    display: inline-flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 1s var(--ease-out) 2.05s,
      transform 1s var(--ease-out) 2.05s;
  }
  .is-loaded .hero__cta-row {
    opacity: 1;
    transform: translateY(0);
  }

  .hero__footer {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 28px;
    border-top: 1px solid var(--gold-line);
    margin-top: 32px;
    opacity: 0;
    transition: opacity 1s var(--ease-out) 2.3s;
  }
  .is-loaded .hero__footer {
    opacity: 1;
  }

  .hero__footer-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: rgba(245, 242, 236, 0.5);
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, var(--color-gold) 0%, transparent 100%);
    animation: scrollPulse 2.5s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.25;
      transform: scaleY(0.6);
      transform-origin: top;
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
      transform-origin: top;
    }
  }

  @media (max-width: 720px) {
    .hero__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-top: 8px;
    }
    .hero__stamp {
      font-size: 9px;
      letter-spacing: 0.2em;
    }
    .hero__mark-wrap {
      width: 84px;
      height: 70px;
      margin-bottom: 22px;
    }
    .hero__wordmark {
      font-size: 12px;
      letter-spacing: 0.5em;
      margin-bottom: 24px;
    }
    .hero__rule {
      margin-bottom: 28px;
    }
    .is-loaded .hero__rule {
      width: 70px;
    }
    .hero__motto {
      font-size: clamp(42px, 12vw, 70px);
      line-height: 1.02;
      margin-bottom: 36px;
    }
    .hero__sub {
      font-size: 17px;
      margin-bottom: 36px;
    }
    .hero__cta-row {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 320px;
    }
    .hero__cta-row .btn {
      justify-content: center;
      padding: 16px 24px;
      font-size: 12px;
    }
    .hero__footer {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
      padding-top: 20px;
      margin-top: 24px;
    }
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__motto .reveal-line__inner,
    .hero__wordmark span,
    .hero__mark-wrap,
    .hero__sub,
    .hero__cta-row,
    .hero__footer,
    .hero__rule,
    .hero__bg-mark {
      opacity: 1 !important;
      transform: none !important;
    }
    .hero__rule {
      width: 100px !important;
    }
  }
</style>
